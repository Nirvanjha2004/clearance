# Clearance — env shape (commit this, keep real values in .env.local — never commit .env.local)
# Copy to .env.local and fill — or set via TrueForge catalog env + Vercel env

# LLM — OpenRouter as OpenAI-compatible (also works with OPENAI_API_KEY / ANTHROPIC_API_KEY directly)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=ox-alpha
OPENAI_API_KEY=sk-...

# DB — Postgres for hosted (Postgres+Redis) or SQLite file:./data/clearance.db for local npx trueforge
DATABASE_URL=postgres://postgres:postgres@localhost:5434/clearance
DATABASE_URL_SQLITE=file:./data/clearance.db

# Gmail — SMTP fallback; TrueForge Gmail MCP uses in-chat OAuth (click Auth in UI)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_TO=recipient@gmail.com

# Exa web search
EXA_API_KEY=3d4fec89-ee7f-4b33-ad1d-5b1ec68c23eb

# GitHub PAT (for GitHub MCP)
GITHUB_TOKEN=ghp_...

# Stripe test
STRIPE_SECRET_KEY=sk_test_...

# App
TRUEFORGE_PORT=3001
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
